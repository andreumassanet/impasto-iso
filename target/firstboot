#!/usr/bin/env bash
# ╭──────────────────────────────────────────────────────────────────────────╮
# │                                                                          │
# │   F I R S T B O O T                                                      │
# │   the desk, installed on the first boot · clone, setup, login screen     │
# │                                                                          │
# │   github.com/andreumassanet/impasto                                      │
# │                                                                          │
# ╰──────────────────────────────────────────────────────────────────────────╯

# Run once, as root, by impasto-firstboot.service on tty1. The system is
# booted, so pacman hooks, services and the network behave as they will from
# now on. The unit only runs while /etc/impasto-install.conf exists.

set -uo pipefail

CONF=/etc/impasto-install.conf
LOG=/var/log/impasto-install.log
SUDOERS=/etc/sudoers.d/zz-impasto-install

REPO=https://github.com/andreumassanet/impasto.git
BRANCH=main
ALSO=
# shellcheck source=/dev/null
. "$CONF"

exec > >(tee -a "$LOG" ${ALSO:+"$ALSO"}) 2>&1


# ── THE SCREEN ──────────────────────────────────────────────────────────────
#
# What `setup` opens on, in the sixteen colours a console has. Both scripts
# here carry a copy: this one is on the medium and firstboot travels inside
# the payload, into a system the medium cannot reach, so there is nowhere the
# two of them could share a file.

MARK=(
    '██  ██▄    ▄██  ███████▄   ▄█████▄   ▄███████  ████████  ▄███████▄'
    '██  ██▀█▄▄█▀██  ██    ██  ██     ██  ██▄▄▄▄▄      ██     ██     ██'
    '██  ██  ▀▀  ██  ███████▀  █████████   ▀▀▀▀▀██     ██     ██     ██'
    '██  ██      ██  ██        ██     ██  ███████▀     ██     ▀███████▀'
)

# Half blocks are in no console font by right: Terminus carries █ and neither
# ▀ nor ▄. default8x16 has all three, at the size the console already is,
# and comes with kbd, which is in base.
mark() {
    local row size rows columns
    if [[ $(tty) == /dev/tty[0-9]* ]]; then setfont default8x16 2>/dev/null; fi
    size=$(stty size 2>/dev/null </dev/tty) || size=
    # shellcheck disable=SC2086
    set -- $size
    rows=${1:-0}
    columns=${2:-0}
    printf '\n'
    # A console with no room for the drawing gets the name instead: the screen
    # under it has to fit, or the menu redraws over whatever scrolled.
    if (( columns < 70 || rows < 28 )); then
        printf '  \e[1;33mI M P A S T O\e[0m\n\n'
        return 0
    fi
    for row in "${MARK[@]}"; do printf '  \e[33m%s\e[0m\n' "$row"; done
    printf '\n'
}

# One keypress, an arrow's three bytes arriving as one word.
key() {
    local k rest
    IFS= read -rsn1 k </dev/tty || return 1
    if [[ $k == $'\e' ]]; then
        IFS= read -rsn2 -t 0.02 rest </dev/tty || rest=
        case $rest in
            '[A') k=up ;;
            '[B') k=down ;;
            *)    k=other ;;
        esac
    fi
    case $k in
        '') k=enter ;;
        j)  k=down ;;
        k)  k=up ;;
    esac
    printf '%s' "$k"
}

# $@ rows, each "name:what it does". What was picked is left in CHOSEN. The
# drawing goes to the terminal rather than to stdout, which in firstboot is a
# pipe into the log, and a log full of cursor moves reads as nothing at all.
CHOSEN=
choose() {
    local -a rows=("$@")
    local at=0 drawn=0 i k name note
    printf '\e[?25l' > /dev/tty
    while :; do
        if (( drawn )); then printf '\e[%dF\e[0J' "$drawn" > /dev/tty; fi
        drawn=0
        for i in "${!rows[@]}"; do
            name=${rows[i]%%:*}
            note=${rows[i]#*:}
            if (( i == at )); then
                printf '  \e[33m▸\e[0m \e[1m%-9s\e[0m %s\n' "$name" "$note" > /dev/tty
            else
                printf '    \e[90m%-9s %s\e[0m\n' "$name" "$note" > /dev/tty
            fi
            drawn=$(( drawn + 1 ))
        done
        printf '\n  \e[1m↑↓\e[0m \e[90mmove\e[0m   \e[1menter\e[0m \e[90mchoose\e[0m\n' > /dev/tty
        drawn=$(( drawn + 2 ))
        k=$(key) || k=enter
        case $k in
            up)    at=$(( at ? at - 1 : ${#rows[@]} - 1 )) ;;
            down)  at=$(( (at + 1) % ${#rows[@]} )) ;;
            enter) break ;;
        esac
    done
    printf '\e[?25h' > /dev/tty
    CHOSEN=${rows[at]%%:*}
}


say() { printf '  %s\n' "$*"; }

# The rule `setup` draws, so what it prints from here on carries on the same
# screen rather than starting a second one.
rule() {
    local name=$1 dashes= fill
    # One `local` expands every assignment before it makes any of them, so a
    # width taken from ${#name} there reads an unset variable.
    fill=$(( 71 - ${#name} ))
    while (( fill-- > 0 )); do dashes+='─'; done
    printf '\n\e[90m── \e[97;1m%s\e[0m \e[90m%s\e[0m\n' "$name" "$dashes"
}

# The sudo rule only lives while this runs: setup asks sudo for pacman and
# for the copy into /, and nobody is there to type a password. Named to sort
# after archinstall's numbered rules, since the last match wins; `sudo -v`
# goes by every rule instead, unless verifypw says any.
cleanup() { rm -f "$SUDOERS"; }
trap cleanup EXIT

online() { curl -fsI --max-time 5 https://archlinux.org >/dev/null 2>&1; }

# Ethernet comes up on its own. Wi-Fi from the live system is not carried
# over, so it is asked for again here. Full-screen programs get the terminal
# itself: their output is not for the log.
network() {
    local i
    for (( i = 0; i < 20; i++ )); do
        online && return 0
        sleep 2
    done
    while ! online; do
        say 'No network. Pick a connection in the next screen, then Quit.'
        read -rp '  Enter to open it, s for a shell ' answer
        case $answer in
            s) bash </dev/tty >/dev/tty 2>&1 ;;
            *) nmtui connect </dev/tty >/dev/tty 2>&1 ;;
        esac
    done
}

# The first person archinstall made: the lowest uid from 1000.
user=$(awk -F: '$3 >= 1000 && $3 < 60000 { print $3, $1 }' /etc/passwd | sort -n | awk 'NR == 1 { print $2 }')
home=$(getent passwd "$user" | cut -d: -f6)

install_desk() {
    printf 'Defaults:%s verifypw=any\n%s ALL=(ALL) NOPASSWD: ALL\n' "$user" "$user" > "$SUDOERS"
    chmod 440 "$SUDOERS"
    if [[ ! -d $home/impasto/.git ]]; then
        rule "impasto ($BRANCH)"
        runuser -u "$user" -- git clone --branch "$BRANCH" "$REPO" "$home/impasto" || return 1
    fi
    # A session bus of its own, so what is stored through D-Bus (dark GTK,
    # Thunar's settings) is written now rather than at the first login.
    runuser -l "$user" -c "cd ~/impasto && dbus-run-session -- ./setup install --noconfirm $*"
}

# A sudo that failed while nobody could answer counts against the account,
# and three lock it: the login screen starts with the count at zero.
finish() {
    rm -f "$CONF"
    faillock --user "$user" --reset 2>/dev/null
    systemctl disable impasto-firstboot.service 2>/dev/null
    rule done
    if systemctl is-enabled --quiet display-manager.service 2>/dev/null; then
        say 'The login screen comes up now.'
        sleep 3
        systemctl --no-block start display-manager.service
    else
        say 'No display manager is enabled: log in on this console.'
        sleep 3
        systemctl --no-block start getty@tty1.service
    fi
    exit 0
}

dmesg -n 1
clear
mark
say 'Installing the desk on the first boot: 10 to 20 minutes, online.'
say "Everything is logged to $LOG."

if [[ -z $user ]]; then
    say 'No user account was made. Create one (useradd -m -G wheel NAME), then reboot.'
    exec bash </dev/tty >/dev/tty 2>&1
fi

rule network
network
say 'online'

args=()
while :; do
    if install_desk "${args[@]}"; then finish; fi
    rule 'the install stopped'
    say "The reason is above, and in $LOG."
    echo
    choose 'again:try the whole thing again' \
           'packages:try again, leaving the packages as they are' \
           'shell:a shell here, and back to this screen' \
           'later:the login screen now, and ./setup install when you like'
    case $CHOSEN in
        packages) args=(--skip-packages) ;;
        shell)    bash </dev/tty >/dev/tty 2>&1 ;;
        later)    finish ;;
        *)        args=() ;;
    esac
done
