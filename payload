#!/usr/bin/env bash
# ╭──────────────────────────────────────────────────────────────────────────╮
# │                                                                          │
# │   P A Y L O A D                                                          │
# │   the first boot, packed into one archinstall custom command             │
# │                                                                          │
# │   github.com/andreumassanet/impasto                                      │
# │                                                                          │
# ╰──────────────────────────────────────────────────────────────────────────╯

# Usage: ./payload REPO BRANCH [ALSO]
# Prints the command. archinstall runs it inside the new system, where the
# live medium cannot be reached, so target/ travels inside it.

set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=${1:?repository}
branch=${2:?branch}
also=${3:-}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cp "$here"/target/* "$tmp/"
printf 'REPO=%q\nBRANCH=%q\nALSO=%q\n' "$repo" "$branch" "$also" > "$tmp/impasto-install.conf"
packed=$(tar -czf - -C "$tmp" --owner=0 --group=0 . | base64 -w0)
printf 'd=$(mktemp -d) && echo %s | base64 -d | tar -xzf - -C "$d" && bash "$d/stage" && rm -rf "$d"\n' "$packed"
